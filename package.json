{
  "name": "opencode-swarm",
  "version": "0.1.0",
  "type": "module",
  "description": "Parallel agent swarms for OpenCode: shared task board, peer messaging, file leases, and a low-friction orchestrator.",
  "license": "MIT",
  "author": "DumDuky",
  "homepage": "https://dumduky.github.io/opencode-swarm/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DumDuky/opencode-swarm.git"
  },
  "bugs": {
    "url": "https://github.com/DumDuky/opencode-swarm/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "ai-agents",
    "multi-agent",
    "swarm",
    "orchestration",
    "parallel-agents",
    "deepseek",
    "opencode-go"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "types": "./src/index.ts",
  "files": [
    "src",
    "assets",
    "README.md",
    "opencode.example.json",
    "swarm.config.example.json",
    "docs",
    "examples/tiny-demo",
    "examples/dynamic-write-set",
    "examples/cwd-independent-check",
    "examples/local-plugin"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.19.5",
    "@opencode-ai/sdk": "1.19.5",
    "@opencode/plugin": "2.2.0",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
